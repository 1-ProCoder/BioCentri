<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Shadows.xaml
        =================
        DropShadowEffect tokens + InnerHighlightLinearGradient for the
        glassmorphism 'inset 0 1px 0 rgba(255,255,255,0.10)' line in
        website/index.css (.glass / .glass-strong).

        Effects are expensive; reuse via StaticResource. Apply to Border /
        Panel via attached property UserControl-style helpers in M2.
    -->

    <!-- ============================================================== -->
    <!-- Drop shadows (used on cards, dialogs, hover lift)                -->
    <!-- ============================================================== -->
    <DropShadowEffect x:Key="Shadows.Card.Default"
                      Color="#000000"
                      Opacity="0.50"
                      BlurRadius="40"
                      ShadowDepth="0" />

    <DropShadowEffect x:Key="Shadows.Card.Focal"
                      Color="#000000"
                      Opacity="0.60"
                      BlurRadius="80"
                      ShadowDepth="20" />

    <DropShadowEffect x:Key="Shadows.Hover.Lift"
                      Color="#000000"
                      Opacity="0.40"
                      BlurRadius="24"
                      ShadowDepth="4" />

    <DropShadowEffect x:Key="Shadows.Accent.Glow"
                      Color="#52818CF8"
                      Opacity="0.60"
                      BlurRadius="32"
                      ShadowDepth="0" />

    <!-- ============================================================== -->
    <!-- Inner highlight (matches .glass inset white-1px-top)            -->
    <!-- ============================================================== -->
    <LinearGradientBrush x:Key="Shadows.InnerHighlight.Default"
                         StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Shadows.InnerHighlight.Strong"
                         StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1FFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================== -->
    <!-- Reticles / glow ring color stops (reused by shader-y overlays)    -->
    <!-- ============================================================== -->
    <SolidColorBrush x:Key="Shadows.GlowInk"
                     Color="#52818CF8" />

</ResourceDictionary>
