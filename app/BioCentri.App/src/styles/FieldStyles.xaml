<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        FieldStyles.xaml
        =================
        Implicit Style entries for native WPF controls. These are how the
        "no default controls anywhere" rule is enforced at M2: every Button,
        TextBox, CheckBox, ScrollBar, and ListBoxItem encountered in any
        XAML scope automatically picks up the dark-themed Fluent-feeling
        chrome defined here.

        Add NEW primitives (Toggle, Chip, Badge, EmptyState, …) to this
        file too, so the entire visual vocabulary is reachable through one
        ResourceDictionary merge.
    -->

    <!-- ============================================================== -->
    <!-- Focus visual: thin, calm, Violet.                                 -->
    <!-- ============================================================== -->
    <Style x:Key="BioFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               Stroke="{StaticResource Brushes.Accent.Indigo}"
                               StrokeThickness="{StaticResource Stroke.Thick}"
                               RadiusX="6" RadiusY="6"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== -->
    <!-- Scrim (dim behind modals).                                         -->
    <!-- ============================================================== -->
    <SolidColorBrush x:Key="Brushes.Scrim" Color="#A0000000" />

    <!-- ============================================================== -->
    <!-- Selector brush for inverse selection (used by SidebarItem, etc.) -->
    <!-- ============================================================== -->
    <SolidColorBrush x:Key="Brushes.Subtle.Surface" Color="#10FFFFFF" />

    <!-- ============================================================== -->
    <!-- Reusable Implicit Styles                                          -->
    <!-- ============================================================== -->

    <!-- Window background: dark base surface already keyed in Themes/Dark.xaml.
         Some windows inherit a thin border to read as elevated. -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brushes.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Pad.Md}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Size.Body}" />
        <Setter Property="FontWeight" Value="{StaticResource Typography.Weight.Medium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BioFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Brushes.Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brushes.Ink.850}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brushes.Border.Hairline}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Pad.Md}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brushes.Accent.Indigo}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brushes.Selection}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Size.Body}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BioFocusVisual}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brushes.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Brushes.Border.Hairline}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Pad.Xs}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.Sans}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BioFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brushes.Ink.700}" />
        <Setter Property="Width" Value="10" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brushes.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Pad.Md}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource BioFocusVisual}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brushes.Ink.700}" />
        <Setter Property="Foreground" Value="{StaticResource Brushes.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brushes.Border.Hairline}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Thin}" />
        <Setter Property="Padding" Value="{StaticResource Spacing.Pad.Sm}" />
        <Setter Property="FontFamily" Value="{StaticResource Typography.Sans}" />
        <Setter Property="FontSize" Value="{StaticResource Typography.Size.Small}" />
    </Style>

</ResourceDictionary>
