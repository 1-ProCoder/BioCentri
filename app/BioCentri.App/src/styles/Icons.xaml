<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icons.xaml
        =================
        Vector StreamGeometry paths used by the Icon user-control. Each
        resource is a `Geometry` drawn from a normalised 24×24 grid (the
        Fluent icon convention). Consumers reference them via
        `Data="{StaticResource Icons.<Name>.Geometry}"` from a `<Path>`.

        Adding a new icon? Match the 24×24 viewport and keep the
        `transform` stream minimal so the rasteriser stays sharp at any DPI.
    -->

    <!-- ============================================================== -->
    <!-- App-shell navigation icons                                         -->
    <!-- ============================================================== -->
    <Geometry x:Key="Icons.Shell.Logo">
        M12 2 L2 7 L12 12 L22 7 Z M2 17 L12 22 L22 17 M2 17 L12 12
    </Geometry>

    <Geometry x:Key="Icons.Route.Dashboard">
        M3 13 H11 V3 H3 Z M13 21 H21 V11 H13 Z M3 21 H11 V15 H3 Z M13 9 H21 V3 H13 Z
    </Geometry>

    <Geometry x:Key="Icons.Route.ProtectedApps">
        M12 2 L4 6 V11 C4 16 8 20 12 22 C16 20 20 16 20 11 V6 Z
    </Geometry>

    <Geometry x:Key="Icons.Route.Rules">
        M5 4 H15 L19 8 V20 H5 Z M9 11 H15 M9 15 H15 M9 7 H13
    </Geometry>

    <Geometry x:Key="Icons.Route.Activity">
        M3 17 L9 11 L13 15 L21 7 M21 7 V12 M21 7 H16
    </Geometry>

    <Geometry x:Key="Icons.Route.Settings">
        M12 2 L13.5 5 L17 4 L17 7.5 L20 8 L19 11 L22 12 L19 13 L20 16 L17 16.5 L17 20 L13.5 19 L12 22 L10.5 19 L7 20 L7 16.5 L4 16 L5 13 L2 12 L5 11 L4 8 L7 7.5 L7 4 L10.5 5 Z M12 9 a3 3 0 1 0 0 6 a3 3 0 1 0 0 -6
    </Geometry>

    <Geometry x:Key="Icons.Route.About">
        M11 4 a9 9 0 1 0 0 18 a9 9 0 1 0 0 -18 Z M11 9 a1 1.2 0 1 0 0 2.4 a1 1.2 0 1 0 0 -2.4 Z M10 13 H12 V18 H10 Z
    </Geometry>

    <Geometry x:Key="Icons.Route.Diagnostics">
        M3 5 H21 V19 H3 Z M6 8 H8 V10 H6 Z M10 8 H12 V10 H10 Z M14 8 H16 V10 H14 Z M6 12 H8 V14 H6 Z M10 12 H18 V14 H10 Z M6 16 H12 V18 H6 Z
    </Geometry>

    <!-- ============================================================== -->
    <!-- Status / chip icons                                                -->
    <!-- ============================================================== -->
    <Geometry x:Key="Icons.Status.Protected">
        M12 2 L4 6 V11 C4 16 8 20 12 22 C16 20 20 16 20 11 V6 Z M9 12 L11 14 L15 10
    </Geometry>

    <Geometry x:Key="Icons.Status.Warning">
        M12 3 L22 20 H2 Z M12 10 V14 M12 17 V17.01
    </Geometry>

    <Geometry x:Key="Icons.Status.Info">
        M11 3 a9 9 0 1 0 0 18 a9 9 0 1 0 0 -18 Z M11 8 V8.01 M11 11 V16
    </Geometry>

    <Geometry x:Key="Icons.Status.Check">
        M5 12 L10 17 L20 7
    </Geometry>

    <!-- ============================================================== -->
    <!-- Action / control icons                                             -->
    <!-- ============================================================== -->
    <Geometry x:Key="Icons.Action.Search">
        M11 3 a8 8 0 1 0 0 16 a8 8 0 1 0 0 -16 Z M21 21 L16.5 16.5
    </Geometry>

    <Geometry x:Key="Icons.Action.Add">
        M12 5 V19 M5 12 H19
    </Geometry>

    <Geometry x:Key="Icons.Action.Close">
        M6 6 L18 18 M18 6 L6 18
    </Geometry>

    <Geometry x:Key="Icons.Action.Menu">
        M4 7 H20 M4 12 H20 M4 17 H14
    </Geometry>

    <Geometry x:Key="Icons.Action.ChevronLeft">
        M15 6 L9 12 L15 18
    </Geometry>

    <Geometry x:Key="Icons.Action.ChevronRight">
        M9 6 L15 12 L9 18
    </Geometry>

    <Geometry x:Key="Icons.Action.More">
        M6 12 a1 1 0 1 0 0 0.2 a1 1 0 1 0 0 -0.2 Z M12 12 a1 1 0 1 0 0 0.2 a1 1 0 1 0 0 -0.2 Z M18 12 a1 1 0 1 0 0 0.2 a1 1 0 1 0 0 -0.2 Z
    </Geometry>

    <!-- ============================================================== -->
    <!-- Window / brand icons                                               -->
    <!-- ============================================================== -->
    <Geometry x:Key="Icons.Brand.Placeholder">
        M4 4 H20 V20 H4 Z M8 8 H16 V16 H8 Z
    </Geometry>

    <!-- ============================================================== -->
    <!-- Common meta-renders: a stroke-only / fill-only style helper       -->
    <!-- Most icons are 1.6-px strokes at 24×24.                            -->
    <!-- ============================================================== -->
    <sys:Double x:Key="Icons.Size.Default" xmlns:sys="clr-namespace:System;assembly=System.Runtime">20</sys:Double>
    <sys:Double x:Key="Icons.StrokeWidth.Default" xmlns:sys="clr-namespace:System;assembly=System.Runtime">1.6</sys:Double>

</ResourceDictionary>
