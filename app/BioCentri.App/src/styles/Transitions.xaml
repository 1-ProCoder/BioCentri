<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Transitions.xaml
        =================
        Reusable Storyboards for page / overlay / focus transitions.

        M3 polish uses seven storyboards:
          * Transitions.Page.Enter   — fade-in + 16-px slide-from-bottom
                                       over 320ms with out-expo spline.
          * Transitions.Page.Exit    — fade-out + 12-px slide-to-top over
                                       220ms with out-expo spline.
          * Transitions.Toast.PopIn  — slide-in-from-right + fade-in,
                                       320ms; reverse for dismiss.
          * Transitions.Dialog.PopIn — scale (0.94 → 1) + fade, 220ms.
          * Transitions.Dimmer.Show  — backdrop fade 160ms.
          * Transitions.Accent.Pulse — gentle 0.65 → 1.0 → 0.65 opacity
                                       loop on hero stat dots.
          * Transitions.Card.Hover   — elevation + border lift for cards
                                       on PointerEnter / leave.

        Easings are inlined as `KeySpline="0.16,1,0.3,1"` (matches the
        website's `out-expo` cubic-bezier(0.16, 1, 0.3, 1)). Per Decision
        9 followup, baml in this SDK refuses to register SplineEase as a
        XAML resource; inlining is the canonical workaround. Consumers
        may also use the `Motion.Easing.OutExpo` field from the C#
        companion file once M5+ adds rich Storyboards.

        Reduced-motion: the boolean resource below is consulted by
        consumers (component-level gating), not by these Storyboards
        themselves. See `Motion.RespectReducedMotion`.
    -->

    <!-- ============================================================== -->
    <!-- Page enter (fade-in + slide-up)                             -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Page.Enter">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)"
            Duration="0:0:0.32">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
            Duration="0:0:0.32">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="16" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ============================================================== -->
    <!-- Page exit (fade-out + slide-up)                              -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Page.Exit">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="1" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="-12"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ============================================================== -->
    <!-- Toast pop-in (slide-in-from-right + fade)                     -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Toast.PopIn">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)"
            Duration="0:0:0.32">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
            Duration="0:0:0.32">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="48" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.32" Value="0"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ============================================================== -->
    <!-- Dialog pop-in (scale + fade)                                 -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Dialog.PopIn">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0.94" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0.94" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ============================================================== -->
    <!-- Backdrop dimmer fade                                     -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Dimmer.Show">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)"
            Duration="0:0:0.16">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.16" Value="1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ============================================================== -->
    <!-- Accent pulse (used on hero stat dots / status indicators)     -->
    <!-- Honours Motion.RespectReducedMotion at consumer level.         -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Accent.Pulse"
                RepeatBehavior="Forever"
                AutoReverse="True">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.Opacity)"
            Duration="0:0:2.6">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0.65" />
            <SplineDoubleKeyFrame KeyTime="0:0:1.3"  Value="1.0"
                                  KeySpline="0.45,0,0.55,1" />
            <SplineDoubleKeyFrame KeyTime="0:0:2.6"  Value="0.65"
                                  KeySpline="0.45,0,0.55,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ============================================================== -->
    <!-- Card hover (scale 1.0 -> 1.012 + opacity 0.95 -> 1.0)         -->
    <!-- Used by PremiumCard via Trigger on PointerEnter / Leave.      -->
    <!-- ============================================================== -->
    <Storyboard x:Key="Transitions.Card.HoverIn">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="1" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.012"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="1" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1.012"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="Transitions.Card.HoverOut">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="1.012" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
            Duration="0:0:0.22">
            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="1.012" />
            <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1"
                                  KeySpline="0.16,1,0.3,1" />
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

</ResourceDictionary>
