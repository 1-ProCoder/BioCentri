<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Spacing.xaml
        =================
        4-px scale, exposed as Doubles for arbitrary gaps and Thickness values
        for padding/margin recipes. Components must consume these instead of
        hard-coded numbers — keeps the rhythm consistent across screens.
    -->

    <!-- ============================================================== -->
    <!-- Single-axis scale (matches website's gap-x scale)               -->
    <!-- ============================================================== -->
    <sys:Double x:Key="Spacing.0">  0</sys:Double>
    <sys:Double x:Key="Spacing.1">  4</sys:Double>
    <sys:Double x:Key="Spacing.2">  8</sys:Double>
    <sys:Double x:Key="Spacing.3"> 12</sys:Double>
    <sys:Double x:Key="Spacing.4"> 16</sys:Double>
    <sys:Double x:Key="Spacing.5"> 20</sys:Double>
    <sys:Double x:Key="Spacing.6"> 24</sys:Double>
    <sys:Double x:Key="Spacing.7"> 32</sys:Double>
    <sys:Double x:Key="Spacing.8"> 40</sys:Double>
    <sys:Double x:Key="Spacing.9"> 56</sys:Double>
    <sys:Double x:Key="Spacing.10">72</sys:Double>

    <!-- ============================================================== -->
    <!-- Padding recipes (uniform corners)                              -->
    <!-- ============================================================== -->
    <Thickness x:Key="Spacing.Pad.Xxs">2</Thickness>
    <Thickness x:Key="Spacing.Pad.Xs">  4</Thickness>
    <Thickness x:Key="Spacing.Pad.Sm">  8</Thickness>
    <Thickness x:Key="Spacing.Pad.Md"> 12</Thickness>
    <Thickness x:Key="Spacing.Pad.Lg"> 16</Thickness>
    <Thickness x:Key="Spacing.Pad.Xl"> 24</Thickness>
    <Thickness x:Key="Spacing.Pad.Xxl">32</Thickness>

    <!-- ============================================================== -->
    <!-- Stack / column gutters — used by StackPanel.Margin recipes       -->
    <!-- ============================================================== -->
    <sys:Double x:Key="Spacing.Gutter.Tight">   8</sys:Double>
    <sys:Double x:Key="Spacing.Gutter.Default"> 16</sys:Double>
    <sys:Double x:Key="Spacing.Gutter.Loose">   24</sys:Double>
    <sys:Double x:Key="Spacing.Gutter.Section"> 56</sys:Double>

    <!-- ============================================================== -->
    <!-- Corner radii (window corners, cards, pills, etc.)               -->
    <!-- ============================================================== -->
    <CornerRadius x:Key="Spacing.Radius.None">  0</CornerRadius>
    <CornerRadius x:Key="Spacing.Radius.Xs">   4</CornerRadius>
    <CornerRadius x:Key="Spacing.Radius.Sm">   8</CornerRadius>
    <CornerRadius x:Key="Spacing.Radius.Md">  12</CornerRadius>
    <CornerRadius x:Key="Spacing.Radius.Lg">  16</CornerRadius>
    <CornerRadius x:Key="Spacing.Radius.Xl">  24</CornerRadius>
    <CornerRadius x:Key="Spacing.Radius.Pill">999</CornerRadius>

</ResourceDictionary>
