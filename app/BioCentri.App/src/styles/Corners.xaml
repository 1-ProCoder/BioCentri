<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Corners.xaml
        =================
        CornerRadius tokens. Sourced from NPM-style 24-px / 16-px / 8-px
        cards used through the website. Spacing.xaml already exposes
        Spacing.Radius.* for layout primitives; this file consolidates the
        global rounded-corner vocabulary used by Buttons, Cards, Toasts.
    -->

    <CornerRadius x:Key="Corners.None">  0</CornerRadius>
    <CornerRadius x:Key="Corners.Xs">    4</CornerRadius>
    <CornerRadius x:Key="Corners.Sm">    8</CornerRadius>
    <CornerRadius x:Key="Corners.Md">   12</CornerRadius>
    <CornerRadius x:Key="Corners.Lg">   16</CornerRadius>
    <CornerRadius x:Key="Corners.Xl">   24</CornerRadius>
    <CornerRadius x:Key="Corners.Pill">999</CornerRadius>

    <!-- Border-thickness and stroke-thickness tokens. Border.Thin is a
         Thickness(1); Stroke.Thin is a Double(1). The two are
         SEMANTICALLY DIFFERENT even when numerically identical, because
         WPF's ThicknessConverter does not auto-coerce a Double into a
         Thickness — passing Stroke.Thin where BorderThickness is expected
         surfaces at runtime as "'1' is not a valid value for property
         'BorderThickness'". Keep these tokens distinct. -->
    <Thickness x:Key="Border.Thin">1</Thickness>
    <sys:Double x:Key="Stroke.Thin">  1</sys:Double>
    <sys:Double x:Key="Stroke.Med">   1.4</sys:Double>
    <sys:Double x:Key="Stroke.Thick"> 2</sys:Double>

</ResourceDictionary>
