<Page x:Class="BioCentri.App.Features.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:header="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:motion="clr-namespace:BioCentri.App.Components.Motion"
      xmlns:surface="clr-namespace:BioCentri.App.Components.Surface"
      xmlns:feedback="clr-namespace:BioCentri.App.Components.Feedback"
      Title="Dashboard"
      Background="Transparent"
      Foreground="{StaticResource Brushes.Text.Primary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,64">

        <StackPanel>
            <header:PageHeader Title="{Binding Title}"
                               Subtitle="{Binding Subtitle}" />

            <!-- Hero: greeting + status + HologramFloat-wrapped logo with ReticleRing behind -->
            <surface:FocalCard Margin="{StaticResource Spacing.Pad.Md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BIOCENTRI"
                                   FontFamily="{StaticResource Typography.Sans}"
                                   FontSize="{StaticResource Typography.Size.Caption}"
                                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                   Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                                   Opacity="0.85"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{Binding GreetingLine}"
                                   FontFamily="{StaticResource Typography.Display}"
                                   FontSize="{StaticResource Typography.Size.H1}"
                                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                   Foreground="{StaticResource Brushes.Text.Violet}"
                                   TextOptions.TextFormattingMode="Display" />

                        <TextBlock Text="{Binding StatusLine}"
                                   FontFamily="{StaticResource Typography.Sans}"
                                   FontSize="{StaticResource Typography.Size.Large}"
                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                   Margin="0,14,0,0"
                                   MaxWidth="540"
                                   TextWrapping="Wrap"
                                   LineHeight="26" />

                        <!-- Quick badges — protected-apps CTA + biometrics status -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Border Background="{StaticResource Brushes.Glass.Tint}"
                                    BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Corners.Pill}"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Brushes.Status.Success}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Windows Hello ready"
                                               FontFamily="{StaticResource Typography.Sans}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.Medium}"
                                               Foreground="{StaticResource Brushes.Text.Primary}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Brushes.Glass.Tint}"
                                    BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Corners.Pill}"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Brushes.Accent.Indigo}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Local-only · no telemetry"
                                               FontFamily="{StaticResource Typography.Sans}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.Medium}"
                                               Foreground="{StaticResource Brushes.Text.Primary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Logo seat: ReticleRing ornament behind, HologramFloat wraps the logo -->
                    <Grid Grid.Column="1" Width="220" Height="220"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <motion:ReticleRing HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        <motion:HologramFloat HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="100" Height="100">
                            <Border Width="100" Height="100"
                                    CornerRadius="50"
                                    Background="{StaticResource Brushes.Accent.Gradient}"
                                    Effect="{StaticResource Elevation.Accent.Glow}">
                                <icon:Icon IconSize="44"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           GeometryKey="Icons.Shell.Logo"
                                           Stroke="White"
                                           StrokeThickness="2.2" />
                            </Border>
                        </motion:HologramFloat>
                    </Grid>
                </Grid>
            </surface:FocalCard>

            <!-- BentoStats grid: 3 cols × 2 rows, asymmetric spans per M3 design language -->
            <TextBlock Text="At a glance"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="12,32,12,8" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: WIDE stat (spans 2 cols) + SMALL stat (col 2) -->
                <surface:BentoStat Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Label="Protected apps"
                                   Value="{Binding Stats[0].Value}"
                                   Caption="{Binding Stats[0].Caption}"
                                   Margin="{StaticResource Spacing.Pad.Sm}" />

                <surface:BentoStat Grid.Row="0" Grid.Column="2"
                                   Label="Active rules"
                                   Value="{Binding Stats[2].Value}"
                                   Caption="{Binding Stats[2].Caption}"
                                   Margin="{StaticResource Spacing.Pad.Sm}" />

                <!-- Row 1: SMALL stat (col 0) + WIDE stat (spans 2 cols) -->
                <surface:BentoStat Grid.Row="1" Grid.Column="0"
                                   Label="Session start"
                                   Value="{Binding Stats[3].Value}"
                                   Caption="{Binding Stats[3].Caption}"
                                   Margin="{StaticResource Spacing.Pad.Sm}" />

                <surface:BentoStat Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Label="Hello challenges"
                                   Value="{Binding Stats[1].Value}"
                                   Caption="{Binding Stats[1].Caption}"
                                   Margin="{StaticResource Spacing.Pad.Sm}" />
            </Grid>

            <!-- Recent activity placeholder list -->
            <TextBlock Text="Recent activity"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="12,32,12,8" />

            <Border Background="{StaticResource Brushes.GlassStrong.Tint}"
                    BorderBrush="{StaticResource Brushes.Border.HairlineInner}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corners.Md}"
                    Padding="{StaticResource Spacing.Pad.Lg}">
                <Border.Effect>
                    <StaticResource ResourceKey="Elevation.1.Resting" />
                </Border.Effect>
                <Grid>
                    <feedback:EmptyState Title="No challenges yet"
                                         Subtitle="When BioCentri gates an app for you, the events will appear here. Activity is fully on-device."
                                         IconKey="Icons.Route.Activity"
                                         Visibility="{Binding Recent.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=zero}" />
                    <ItemsControl ItemsSource="{Binding Recent}"
                                  Visibility="{Binding Recent.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=nonzero}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"
                                             Fill="{StaticResource Brushes.Accent.Indigo}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource Typography.Sans}"
                                                   FontSize="{StaticResource Typography.Size.Body}"
                                                   FontWeight="{StaticResource Typography.Weight.Medium}"
                                                   Foreground="{StaticResource Brushes.Text.Primary}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontFamily="{StaticResource Typography.Sans}"
                                                   FontSize="{StaticResource Typography.Size.Small}"
                                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                                               FontFamily="{StaticResource Typography.Monospace}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               Foreground="{StaticResource Brushes.Text.Muted}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReadinessLine}"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,32,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
