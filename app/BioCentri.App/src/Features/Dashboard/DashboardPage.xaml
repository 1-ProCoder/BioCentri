<Page x:Class="BioCentri.App.Features.Dashboard.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:header="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:motion="clr-namespace:BioCentri.App.Components.Motion"
      xmlns:surface="clr-namespace:BioCentri.App.Components.Surface"
      xmlns:feedback="clr-namespace:BioCentri.App.Components.Feedback"
      xmlns:items="clr-namespace:BioCentri.App.Features.Dashboard"
      Title="Dashboard"
      Background="Transparent"
      Foreground="{StaticResource Brushes.Text.Primary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,64">

        <StackPanel>
            <header:PageHeader Title="{Binding Title}"
                               Subtitle="{Binding Subtitle}" />

            <!-- System Protection Active — polished hero card -->
            <surface:FocalCard Margin="{StaticResource Spacing.Pad.Md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Shield medallion -->
                    <Border Grid.Column="0"
                            Width="88" Height="88"
                            CornerRadius="44"
                            Background="{StaticResource Brushes.Accent.Gradient}"
                            Effect="{StaticResource Elevation.Accent.Glow}"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0">
                        <icon:Icon IconSize="38"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   GeometryKey="Icons.Route.ProtectedApps"
                                   Stroke="White"
                                   StrokeThickness="2.2" />
                    </Border>

                    <!-- Headline + status copy -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="System Protection Active"
                                   FontFamily="{StaticResource Typography.Display}"
                                   FontSize="{StaticResource Typography.Size.H2}"
                                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                   Foreground="{StaticResource Brushes.Text.Primary}"
                                   TextOptions.TextFormattingMode="Display" />

                        <TextBlock Text="{Binding StatusLine}"
                                   FontFamily="{StaticResource Typography.Sans}"
                                   FontSize="{StaticResource Typography.Size.Body}"
                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                   Margin="0,8,0,0"
                                   MaxWidth="640"
                                   TextWrapping="Wrap"
                                   LineHeight="22" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Background="{StaticResource Brushes.Glass.Tint}"
                                    BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Corners.Pill}"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Brushes.Status.Success}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Windows Hello ready"
                                               FontFamily="{StaticResource Typography.Sans}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.Medium}"
                                               Foreground="{StaticResource Brushes.Text.Primary}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource Brushes.Glass.Tint}"
                                    BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Corners.Pill}"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Brushes.Accent.Indigo}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="Local-only · no telemetry"
                                               FontFamily="{StaticResource Typography.Sans}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.Medium}"
                                               Foreground="{StaticResource Brushes.Text.Primary}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Reticle ornament -->
                    <motion:ReticleRing Grid.Column="2"
                                        Width="220" Height="220"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                </Grid>
            </surface:FocalCard>

            <!-- 4-col stat tiles -->
            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:DashboardStatRow}">
                        <header:StatisticCard Label="{Binding Label}"
                                              Value="{Binding Value}"
                                              Delta="{Binding Caption}"
                                              Margin="{StaticResource Spacing.Pad.Sm}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent Activity — table format -->
            <TextBlock Text="Recent Activity"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="0,32,0,8" />

            <Border Background="{StaticResource Brushes.GlassStrong.Tint}"
                    BorderBrush="{StaticResource Brushes.Border.HairlineInner}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corners.Md}"
                    Padding="0">
                <Border.Effect>
                    <StaticResource ResourceKey="Elevation.1.Resting" />
                </Border.Effect>

                <!-- Column header row -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brushes.Glass.Tint}"
                            BorderBrush="{StaticResource Brushes.Border.HairlineSoft}"
                            BorderThickness="0,0,0,1"
                            Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Time"
                                       FontFamily="{StaticResource Typography.Sans}"
                                       FontSize="{StaticResource Typography.Size.Caption}"
                                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                       Foreground="{StaticResource Brushes.Text.Muted}"
                                       Width="100" />
                            <TextBlock Grid.Column="1" Text="Application"
                                       FontFamily="{StaticResource Typography.Sans}"
                                       FontSize="{StaticResource Typography.Size.Caption}"
                                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                       Foreground="{StaticResource Brushes.Text.Muted}" />
                            <TextBlock Grid.Column="2" Text="Event"
                                       FontFamily="{StaticResource Typography.Sans}"
                                       FontSize="{StaticResource Typography.Size.Caption}"
                                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                       Foreground="{StaticResource Brushes.Text.Muted}" />
                            <TextBlock Grid.Column="3" Text="Status"
                                       FontFamily="{StaticResource Typography.Sans}"
                                       FontSize="{StaticResource Typography.Size.Caption}"
                                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                       Foreground="{StaticResource Brushes.Text.Muted}" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <feedback:EmptyState Grid.Row="1"
                                         Title="No challenges yet"
                                         Subtitle="When BioCentri gates an app for you, the events will appear here. Activity is fully on-device."
                                         IconKey="Icons.Route.Activity"
                                         Visibility="{Binding Recent.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=zero}" />
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Recent}"
                                  Visibility="{Binding Recent.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=nonzero}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brushes.Border.HairlineSoft}"
                                        BorderThickness="0,0,0,1"
                                        Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat='{}{0:hh:mm tt}'}"
                                                   Width="100"
                                                   FontFamily="{StaticResource Typography.Monospace}"
                                                   FontSize="{StaticResource Typography.Size.Small}"
                                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource Typography.Sans}"
                                                       FontSize="{StaticResource Typography.Size.Body}"
                                                       FontWeight="{StaticResource Typography.Weight.Medium}"
                                                       Foreground="{StaticResource Brushes.Text.Primary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Event}"
                                                   FontFamily="{StaticResource Typography.Sans}"
                                                   FontSize="{StaticResource Typography.Size.Small}"
                                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="3"
                                                Background="{StaticResource Brushes.Subtle.Surface}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Corners.Pill}"
                                                Padding="10,3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brushes.Status.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brushes.Status.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Info">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brushes.Accent.IndigoLight}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontFamily="{StaticResource Typography.Sans}"
                                                       FontSize="{StaticResource Typography.Size.Caption}"
                                                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                                       Foreground="{StaticResource Brushes.Status.Success}"
                                                       TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource Brushes.Status.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                                <Setter Property="Foreground" Value="{StaticResource Brushes.Status.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Info">
                                                                <Setter Property="Foreground" Value="{StaticResource Brushes.Accent.IndigoLight}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <TextBlock Text="{Binding ReadinessLine}"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,32,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
