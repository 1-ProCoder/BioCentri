<Page x:Class="BioCentri.App.Features.Diagnostics.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:header="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:nav="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:items="clr-namespace:BioCentri.App.Features.Diagnostics"
      Title="Diagnostics"
      Background="Transparent"
      Foreground="{StaticResource Brushes.Text.Primary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,64">

        <StackPanel>
            <!-- Title row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="BIOCENTRI"
                               FontFamily="{StaticResource Typography.Sans}"
                               FontSize="{StaticResource Typography.Size.Caption}"
                               FontWeight="{StaticResource Typography.Weight.SemiBold}"
                               Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                               Opacity="0.85" />
                    <TextBlock Text="System Diagnostics and Probes"
                               FontFamily="{StaticResource Typography.Display}"
                               FontSize="{StaticResource Typography.Size.H1}"
                               FontWeight="{StaticResource Typography.Weight.SemiBold}"
                               Foreground="{StaticResource Brushes.Text.Primary}"
                               TextOptions.TextFormattingMode="Display"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Padding="14,9"
                        Background="{StaticResource Brushes.Accent.Indigo}"
                        Foreground="White"
                        FontFamily="{StaticResource Typography.Sans}"
                        FontSize="{StaticResource Typography.Size.Small}"
                        FontWeight="{StaticResource Typography.Weight.SemiBold}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ProbeCommand}">
                    <StackPanel Orientation="Horizontal">
                        <icon:Icon IconSize="14"
                                   Stroke="White"
                                   StrokeThickness="2.2"
                                   GeometryKey="Icons.Action.Add"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Re-probe System"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Environment cards -->
            <TextBlock Text="Environment"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="0,32,0,8" />

            <ItemsControl ItemsSource="{Binding Readouts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:DiagnosticsRow}">
                        <Border Background="{StaticResource Brushes.Surface.Card}"
                                BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Corners.Md}"
                                Padding="20,16"
                                Margin="{StaticResource Spacing.Pad.Sm}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}"
                                           FontFamily="{StaticResource Typography.Sans}"
                                           FontSize="{StaticResource Typography.Size.Caption}"
                                           FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                           Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Value}"
                                           FontFamily="{StaticResource Typography.Display}"
                                           FontSize="{StaticResource Typography.Size.Body}"
                                           FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                           Foreground="{StaticResource Brushes.Text.Primary}"
                                           TextWrapping="Wrap"
                                           TextOptions.TextFormattingMode="Display" />
                                <TextBlock Text="{Binding Caption}"
                                           FontFamily="{StaticResource Typography.Sans}"
                                           FontSize="{StaticResource Typography.Size.Caption}"
                                           Foreground="{StaticResource Brushes.Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Console Log Stream -->
            <TextBlock Text="Console Log Stream"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="0,32,0,8" />

            <Border Background="#FF06080C"
                    BorderBrush="{StaticResource Brushes.Border.Hairline}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Corners.Md}"
                    Padding="16">
                <ItemsControl ItemsSource="{Binding LogStream}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type items:ConsoleLogEntry}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding Timestamp}"
                                           FontFamily="Consolas, Courier New, Monospace"
                                           FontSize="{StaticResource Typography.Size.Caption}"
                                           Foreground="#FF6B7280"
                                           Width="160"
                                           VerticalAlignment="Center" />
                                <Border Background="Transparent"
                                        BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                        CornerRadius="2"
                                        Padding="6,1"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Severity}"
                                               FontFamily="Consolas, Courier New, Monospace"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                               Foreground="#FFA78BFA" />
                                </Border>
                                <TextBlock Text="|"
                                           FontFamily="Consolas, Courier New, Monospace"
                                           Foreground="#FF3F3F46"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Description}"
                                           FontFamily="Consolas, Courier New, Monospace"
                                           FontSize="{StaticResource Typography.Size.Small}"
                                           Foreground="#FFE4E4E7"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Recent signals -->
            <TextBlock Text="Recent signals"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="0,32,0,8" />

            <ItemsControl ItemsSource="{Binding Signals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:DiagnosticsSignalRow}">
                        <Border Margin="0,0,0,8"
                                Padding="14,10"
                                Background="{StaticResource Brushes.Subtle.Surface}"
                                BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Corners.Md}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource Brushes.Surface.Card}"
                                        BorderBrush="{StaticResource Brushes.Accent.Indigo}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Corners.Pill}"
                                        Padding="10,3"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Severity}"
                                               FontFamily="{StaticResource Typography.Monospace}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                               Foreground="{StaticResource Brushes.Accent.IndigoLight}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Description}"
                                           FontFamily="{StaticResource Typography.Sans}"
                                           FontSize="{StaticResource Typography.Size.Small}"
                                           Foreground="{StaticResource Brushes.Text.Muted}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
