<UserControl x:Class="BioCentri.App.Features.ProtectedApps.AppPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
             xmlns:feedback="clr-namespace:BioCentri.App.Components.Feedback"
             Width="560"
             Background="{StaticResource Brushes.Surface.Base}"
             Foreground="{StaticResource Brushes.Text.Primary}"
             Focusable="True"
             KeyDown="OnEscapeKey">

    <Border CornerRadius="{StaticResource Corners.Lg}"
            BorderBrush="{StaticResource Brushes.Border.Hairline}"
            BorderThickness="1"
            Padding="{StaticResource Spacing.Pad.Lg}">
        <Border.Effect>
            <StaticResource ResourceKey="Elevation.2.Resting" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />     <!-- header  -->
                <RowDefinition Height="Auto" />     <!-- search  -->
                <RowDefinition Height="*" />        <!-- list    -->
                <RowDefinition Height="Auto" />     <!-- footer  -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Add application"
                           FontFamily="{StaticResource Typography.Display}"
                           FontSize="{StaticResource Typography.Size.Title}"
                           FontWeight="{StaticResource Typography.Weight.SemiBold}"
                           Foreground="{StaticResource Brushes.Text.Primary}" />
                <TextBlock Text="Pick a discovered application to protect with Windows Hello."
                           FontFamily="{StaticResource Typography.Sans}"
                           FontSize="{StaticResource Typography.Size.Small}"
                           Foreground="{StaticResource Brushes.Text.Muted}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Search -->
            <TextBox Grid.Row="1"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource Brushes.Subtle.Surface}"
                     Foreground="{StaticResource Brushes.Text.Primary}"
                     CaretBrush="{StaticResource Brushes.Accent.Indigo}"
                     BorderBrush="{StaticResource Brushes.Border.Hairline}"
                     BorderThickness="1"
                     Padding="12,8"
                     FontFamily="{StaticResource Typography.Sans}"
                     FontSize="{StaticResource Typography.Size.Small}"
                     Margin="0,0,0,12" />

            <!-- Discovered list / loading / error -->
            <Grid Grid.Row="2" MinHeight="220">
                <feedback:LoadingState Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brushes.Status.Danger}"
                           FontFamily="{StaticResource Typography.Sans}"
                           FontSize="{StaticResource Typography.Size.Small}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />

                <feedback:EmptyState Visibility="{Binding Filtered.Count, Converter={StaticResource CountToVisibility}}"
                                     Title="No matching applications"
                                     Subtitle="Try a different search term, or close this dialog and add the app manually later."
                                     IconKey="Icons.Status.Info" />

                <ListBox ItemsSource="{Binding Filtered}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brushes.Subtle.Surface}"
                                    BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Corners.Md}"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <icon:Icon Grid.Column="0"
                                               IconSize="20"
                                               Stroke="{StaticResource Brushes.Accent.Indigo}"
                                               StrokeThickness="1.6"
                                               GeometryKey="{Binding IconKey}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{StaticResource Typography.Sans}"
                                                   FontSize="{StaticResource Typography.Size.Body}"
                                                   FontWeight="{StaticResource Typography.Weight.Medium}"
                                                   Foreground="{StaticResource Brushes.Text.Primary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Publisher}"
                                                   FontFamily="{StaticResource Typography.Sans}"
                                                   FontSize="{StaticResource Typography.Size.Small}"
                                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Publisher, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Protect"
                                            Padding="14,6"
                                            Background="{StaticResource Brushes.Accent.Indigo}"
                                            Foreground="White"
                                            FontFamily="{StaticResource Typography.Sans}"
                                            FontSize="{StaticResource Typography.Size.Small}"
                                            FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Footer -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel"
                        Padding="14,8"
                        Background="{StaticResource Brushes.Subtle.Surface}"
                        Foreground="{StaticResource Brushes.Text.Primary}"
                        FontFamily="{StaticResource Typography.Sans}"
                        FontSize="{StaticResource Typography.Size.Small}"
                        FontWeight="{StaticResource Typography.Weight.Medium}"
                        BorderBrush="{StaticResource Brushes.Border.Hairline}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
