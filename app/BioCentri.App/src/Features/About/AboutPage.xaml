<Page x:Class="BioCentri.App.Features.About.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:header="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:nav="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:surface="clr-namespace:BioCentri.App.Components.Surface"
      xmlns:items="clr-namespace:BioCentri.App.Features.About"
      Title="About"
      Background="Transparent"
      Foreground="{StaticResource Brushes.Text.Primary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="32,32,32,64">

        <StackPanel>
            <header:PageHeader Title="{Binding Title}"
                               Subtitle="{Binding Subtitle}"
                               Eyebrow="BioCentri" />

            <!-- Brand hero -->
            <surface:FocalCard Margin="{StaticResource Spacing.Pad.Md}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding BrandLine}"
                                   FontFamily="{StaticResource Typography.Display}"
                                   FontSize="{StaticResource Typography.Size.Display}"
                                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                   Foreground="{StaticResource Brushes.Text.Primary}" />
                        <TextBlock Text="{Binding BrandTagline}"
                                   FontFamily="{StaticResource Typography.Sans}"
                                   FontSize="{StaticResource Typography.Size.Large}"
                                   Foreground="{StaticResource Brushes.Text.Muted}"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="100"
                            Height="100"
                            CornerRadius="50"
                            Background="{StaticResource Brushes.Accent.Gradient}"
                            Effect="{StaticResource Elevation.Accent.Glow}">
                        <icon:Icon IconSize="44"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   GeometryKey="Icons.Shell.Logo"
                                   Stroke="White"
                                   StrokeThickness="2.2" />
                    </Border>
                </Grid>
            </surface:FocalCard>

            <!-- 3-up stat grid -->
            <ItemsControl ItemsSource="{Binding Stats}" Margin="12,32,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:AboutStatRow}">
                        <nav:StatisticCard Label="{Binding Label}"
                                          Value="{Binding Value}"
                                          Delta="{Binding Caption}"
                                          Margin="{StaticResource Spacing.Pad.Sm}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Links -->
            <TextBlock Text="Links"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="12,32,12,8" />
            <ItemsControl ItemsSource="{Binding Links}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:AboutLinkRow}">
                        <Border Margin="{StaticResource Spacing.Pad.Sm}"
                                Background="{StaticResource Brushes.Surface.Card}"
                                BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Corners.Md}"
                                Padding="{StaticResource Spacing.Pad.Lg}">
                            <Border.Effect>
                                <StaticResource ResourceKey="Elevation.1.Resting" />
                            </Border.Effect>
                            <StackPanel>
                                <icon:Icon IconSize="20"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           GeometryKey="{Binding IconKey}"
                                           Stroke="{StaticResource Brushes.Accent.Indigo}" />
                                <TextBlock Text="{Binding Title}"
                                           FontFamily="{StaticResource Typography.Sans}"
                                           FontSize="{StaticResource Typography.Size.Body}"
                                           FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                           Foreground="{StaticResource Brushes.Text.Primary}"
                                           Margin="0,12,0,0" />
                                <TextBlock Text="{Binding Description}"
                                           FontFamily="{StaticResource Typography.Sans}"
                                           FontSize="{StaticResource Typography.Size.Small}"
                                           Foreground="{StaticResource Brushes.Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />
                                <TextBlock Text="{Binding Url}"
                                           FontFamily="{StaticResource Typography.Monospace}"
                                           FontSize="{StaticResource Typography.Size.Caption}"
                                           Foreground="{StaticResource Brushes.Accent.IndigoLight}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Roadmap -->
            <TextBlock Text="Roadmap"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="12,32,12,8" />
            <ItemsControl ItemsSource="{Binding Roadmap}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type items:AboutRoadmapRow}">
                        <Border Margin="0,0,0,8"
                                Padding="14,10"
                                Background="{StaticResource Brushes.Subtle.Surface}"
                                BorderBrush="{StaticResource Brushes.Border.Hairline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Corners.Md}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource Brushes.Surface.Card}"
                                        BorderBrush="{StaticResource Brushes.Accent.Indigo}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Corners.Pill}"
                                        Padding="10,3"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Milestone}"
                                               FontFamily="{StaticResource Typography.Monospace}"
                                               FontSize="{StaticResource Typography.Size.Caption}"
                                               FontWeight="{StaticResource Typography.Weight.SemiBold}"
                                               Foreground="{StaticResource Brushes.Accent.IndigoLight}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Description}"
                                           FontFamily="{StaticResource Typography.Sans}"
                                           FontSize="{StaticResource Typography.Size.Small}"
                                           Foreground="{StaticResource Brushes.Text.Muted}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding CreditsLine}"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,32,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
