<Grid x:Class="BioCentri.App.Components.Nav.TopBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:nav="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:inputs="clr-namespace:BioCentri.App.Components.Inputs"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <!-- Glass-effect background -->
    <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F2060606" Offset="0.0" />
            <GradientStop Color="#F0060606" Offset="1.0" />
        </LinearGradientBrush>
    </Grid.Background>

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Bottom hairline -->
    <Border BorderBrush="{StaticResource Brushes.Border.HairlineSoft}"
            BorderThickness="0,0,0,1" />

    <!-- Left: route label -->
    <StackPanel Grid.Column="0"
                Orientation="Vertical"
                VerticalAlignment="Center"
                Margin="32,0,0,0">
        <TextBlock x:Name="EyebrowText"
                   Text="BioCentri"
                   FontFamily="{StaticResource Typography.Sans}"
                   FontSize="{StaticResource Typography.Size.Caption}"
                   FontWeight="{StaticResource Typography.Weight.Medium}"
                   Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                   Margin="0,0,0,3"
                   Opacity="0.9" />
        <TextBlock x:Name="TitleText"
                   Text="Dashboard"
                   FontFamily="{StaticResource Typography.Display}"
                   FontSize="{StaticResource Typography.Size.H3}"
                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                   Foreground="{StaticResource Brushes.Text.Primary}"
                   TextOptions.TextFormattingMode="Display" />
    </StackPanel>

    <!-- Right: status pill -->
    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,24,0">
        <nav:StatusPill x:Name="StatusDisplay"
                        Label="BioCentri Online"
                        Status="Active"
                        Margin="0,0,8,0" />
        <icon:Icon IconSize="18"
                   GeometryKey="Icons.Action.More"
                   Stroke="{StaticResource Brushes.Text.Muted}"
                   VerticalAlignment="Center"
                   Opacity="0.6" />
    </StackPanel>
</Grid>
