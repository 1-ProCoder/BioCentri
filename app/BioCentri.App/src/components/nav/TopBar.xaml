<Grid x:Class="BioCentri.App.Components.Nav.TopBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:nav="clr-namespace:BioCentri.App.Components.Nav"
      xmlns:inputs="clr-namespace:BioCentri.App.Components.Inputs"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <!-- Glass-effect background. Polished: asymmetric top highlight makes
         the TopBar read as a raised glass surface instead of a flat
         slab, matching the website's frosted chrome. -->
    <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8060608" Offset="0.0" />
            <GradientStop Color="#F2060606" Offset="0.55" />
            <GradientStop Color="#EE060606" Offset="1.0" />
        </LinearGradientBrush>
    </Grid.Background>

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- Accent gradient bottom border: thin 1px hairline, then a 1px
         indigo→emerald accent underneath, so the boundary visually
         'pulses' with brand colour. Designer championed the look in
         the website footer. -->
    <Border BorderBrush="{StaticResource Brushes.Border.HairlineSoft}"
            BorderThickness="0,0,0,1" />
    <Border Height="1"
            VerticalAlignment="Bottom"
            Margin="0,1,0,0"
            IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="Transparent" Offset="0.0" />
                <GradientStop Color="{StaticResource Colors.Accent.IndigoGlow}" Offset="0.25" />
                <GradientStop Color="{StaticResource Colors.Accent.EmeraldGlow}" Offset="0.75" />
                <GradientStop Color="Transparent" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
    </Border>

    <!-- Left: route label. Polished: eyebrow uses looser letter-spacing
         so the brand chip reads as a confident kicker; the route title
         picks up the same Display typeface the dashboard uses so the
         two surfaces feel like part of one product. -->
    <StackPanel Grid.Column="0"
                Orientation="Vertical"
                VerticalAlignment="Center"
                Margin="32,0,0,0">
        <TextBlock x:Name="EyebrowText"
                   Text="BIOCENTRI"
                   FontFamily="{StaticResource Typography.Sans}"
                   FontSize="{StaticResource Typography.Size.Caption}"
                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                   Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                   Margin="0,0,0,3"
                   Opacity="0.85">
            <TextBlock.Effect>
                <DropShadowEffect Color="#8B5CF6" BlurRadius="6" ShadowDepth="0" Opacity="0.35" />
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock x:Name="TitleText"
                   Text="Dashboard"
                   FontFamily="{StaticResource Typography.Display}"
                   FontSize="{StaticResource Typography.Size.H3}"
                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                   Foreground="{StaticResource Brushes.Text.Primary}"
                   TextOptions.TextFormattingMode="Display" />
    </StackPanel>

    <!-- Right: status pill -->
    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,24,0">
        <nav:StatusPill x:Name="StatusDisplay"
                        Label="BioCentri Online"
                        Status="Active"
                        Margin="0,0,8,0" />
        <icon:Icon IconSize="18"
                   GeometryKey="Icons.Action.More"
                   Stroke="{StaticResource Brushes.Text.Muted}"
                   VerticalAlignment="Center"
                   Opacity="0.6" />
    </StackPanel>
</Grid>
