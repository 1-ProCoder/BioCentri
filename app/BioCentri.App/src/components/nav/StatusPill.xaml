<Border x:Class="BioCentri.App.Components.Nav.StatusPill"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
        Background="{StaticResource Brushes.Subtle.Surface}"
        BorderBrush="{StaticResource Brushes.Border.Hairline}"
        BorderThickness="1"
        CornerRadius="{StaticResource Corners.Pill}"
        Padding="{StaticResource Spacing.Pad.Sm}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot"
                 Width="8" Height="8"
                 Margin="0,0,8,0"
                 VerticalAlignment="Center"
                 Fill="{StaticResource Brushes.Status.Success}" />

        <icon:Icon x:Name="LeadingIcon"
                   IconSize="14"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   GeometryKey="Icons.Status.Info"
                   Stroke="{StaticResource Brushes.Text.Muted}" />

        <TextBlock x:Name="LabelText"
                   Text="Status"
                   FontFamily="{StaticResource Typography.Sans}"
                   FontSize="{StaticResource Typography.Size.Small}"
                   Foreground="{StaticResource Brushes.Text.Muted}"
                   VerticalAlignment="Center" />
    </StackPanel>

</Border>
