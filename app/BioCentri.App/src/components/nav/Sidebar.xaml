<Grid x:Class="BioCentri.App.Components.Nav.Sidebar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      xmlns:nav="clr-namespace:BioCentri.App.Components.Nav"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <!-- Glass backdrop: Ink.900 at 85% opacity layered over a subtle gradient -->
    <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E50A0A0B" Offset="0.0" />
            <GradientStop Color="#EB0A0A0B" Offset="0.5" />
            <GradientStop Color="#E00A0A0B" Offset="1.0" />
        </LinearGradientBrush>
    </Grid.Background>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Brand block -->
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="20,20,20,12"
                VerticalAlignment="Center">
        <Border Width="36"
                Height="36"
                CornerRadius="10"
                Background="{StaticResource Brushes.Accent.Gradient}"
                Effect="{StaticResource Elevation.Accent.Glow}">
            <icon:Icon IconSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       GeometryKey="Icons.Shell.Logo"
                       Stroke="White"
                       StrokeThickness="1.8" />
        </Border>
        <StackPanel Margin="12,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock x:Name="BrandText"
                       Text="BioCentri"
                       FontFamily="{StaticResource Typography.Display}"
                       FontSize="{StaticResource Typography.Size.Large}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Text.Primary}"
                       TextOptions.TextFormattingMode="Display" />
            <TextBlock x:Name="BrandSubText"
                       Text="Local-first security"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}"
                       Margin="0,3,0,0"
                       Visibility="Visible" />
        </StackPanel>
    </StackPanel>

    <!-- Hairline divider -->
    <Border Grid.Row="1"
            BorderBrush="{StaticResource Brushes.Border.HairlineSoft}"
            BorderThickness="0,1,0,0"
            Margin="16,4,16,14" />

    <!-- Section eyebrow + nav items -->
    <StackPanel Grid.Row="2"
                Orientation="Vertical"
                Margin="10,0,10,0">
        <TextBlock x:Name="NavLabel"
                   Text="Navigation"
                   FontFamily="{StaticResource Typography.Sans}"
                   FontSize="{StaticResource Typography.Size.Caption}"
                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                   Foreground="{StaticResource Brushes.Text.Muted}"
                   Margin="14,4,0,10"
                   Opacity="0.6" />
        <StackPanel x:Name="ItemsHost"
                    Orientation="Vertical" />
    </StackPanel>

    <!-- Bottom: online indicator + collapse -->
    <Grid Grid.Row="3"
          Margin="16,8,16,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <!-- Pulse dot -->
            <Border Width="7"
                    Height="7"
                    CornerRadius="4"
                    Background="{StaticResource Brushes.Status.Success}"
                    Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#34D399"
                                      BlurRadius="6"
                                      ShadowDepth="0"
                                      Opacity="0.6" />
                </Border.Effect>
            </Border>
            <TextBlock x:Name="HealthText"
                       Text="All systems operational"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       FontWeight="{StaticResource Typography.Weight.Medium}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Column="1"
                x:Name="ToggleButton"
                Background="{StaticResource Brushes.Subtle.Surface}"
                BorderBrush="{StaticResource Brushes.Border.Hairline}"
                BorderThickness="1"
                CornerRadius="{StaticResource Corners.Pill}"
                Padding="8,4"
                ToolTip="Collapse sidebar"
                Cursor="Hand"
                AutomationProperties.Name="Collapse sidebar"
                MouseLeftButtonUp="OnToggleClicked">
            <icon:Icon x:Name="ToggleIcon"
                       IconSize="16"
                       GeometryKey="Icons.Action.ChevronLeft"
                       Stroke="{StaticResource Brushes.Text.Muted}" />
        </Border>
    </Grid>
</Grid>
