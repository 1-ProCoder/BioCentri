<Border x:Class="BioCentri.App.Components.Nav.SettingsRow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
        Background="Transparent"
        BorderBrush="{StaticResource Brushes.Border.Hairline}"
        BorderThickness="0,0,0,1"
        Padding="0,16"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">
        <icon:Icon x:Name="LeadingIcon"
                   DockPanel.Dock="Left"
                   IconSize="20"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   GeometryKey="Icons.Route.Settings"
                   Stroke="{StaticResource Brushes.Accent.IndigoLight}" />

        <ContentPresenter x:Name="TrailingAction"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="{StaticResource Spacing.Pad.Lg}" />

        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="Setting"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Body}"
                       FontWeight="{StaticResource Typography.Weight.Medium}"
                       Foreground="{StaticResource Brushes.Text.Primary}" />
            <TextBlock x:Name="DescriptionText"
                       Text="Description"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource Spacing.Pad.Xs}" />
        </StackPanel>
    </DockPanel>

</Border>
