<Border x:Class="BioCentri.App.Components.Nav.ListTile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
        Background="{StaticResource Brushes.Ink.850}"
        BorderBrush="{StaticResource Brushes.Border.Hairline}"
        BorderThickness="1"
        CornerRadius="{StaticResource Corners.Md}"
        Padding="{StaticResource Spacing.Pad.Md}"
        Margin="{StaticResource Spacing.Pad.Xs}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <DockPanel LastChildFill="True">
        <icon:Icon x:Name="LeadingIcon"
                   DockPanel.Dock="Left"
                   IconSize="20"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   GeometryKey="Icons.Brand.Placeholder"
                   Stroke="{StaticResource Brushes.Accent.IndigoLight}" />

        <ContentPresenter x:Name="TrailingActions"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right"
                          Margin="{StaticResource Spacing.Pad.Md}" />

        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="Title"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Body}"
                       FontWeight="{StaticResource Typography.Weight.Medium}"
                       Foreground="{StaticResource Brushes.Text.Primary}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="SubtitleText"
                       Text="Subtitle"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>

</Border>
