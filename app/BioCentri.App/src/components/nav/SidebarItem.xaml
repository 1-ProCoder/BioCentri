<Border x:Class="BioCentri.App.Components.Nav.SidebarItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
        x:Name="Root"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="{StaticResource Corners.Pill}"
        Padding="0"
        Margin="0,1,0,1"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Cursor="Hand"
        MouseLeftButtonUp="OnSelected"
        AutomationProperties.Name="{Binding Title}">

    <Grid x:Name="Container"
          VerticalAlignment="Center"
          MinHeight="44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Active stripe — glows when selected -->
        <Border x:Name="SelectionStripe"
                Grid.Column="0"
                Width="3"
                CornerRadius="2"
                Background="{StaticResource Brushes.Accent.Indigo}"
                Opacity="0"
                VerticalAlignment="Stretch"
                Margin="1,6,3,6">
            <Border.Effect>
                <DropShadowEffect Color="#818CF8"
                                  BlurRadius="8"
                                  ShadowDepth="0"
                                  Opacity="0" />
            </Border.Effect>
        </Border>

        <!-- Icon -->
        <icon:Icon x:Name="LeadingIcon"
                   Grid.Column="1"
                   IconSize="20"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Margin="0,0,10,0"
                   GeometryKey="Icons.Route.Dashboard"
                   Stroke="{StaticResource Brushes.Text.Muted}" />

        <!-- Label -->
        <TextBlock x:Name="TitleText"
                   Grid.Column="2"
                   Text="Title"
                   FontFamily="{StaticResource Typography.Sans}"
                   FontSize="{StaticResource Typography.Size.Body}"
                   FontWeight="{StaticResource Typography.Weight.Medium}"
                   Foreground="{StaticResource Brushes.Text.Muted}"
                   VerticalAlignment="Center" />
    </Grid>

    <Border.Style>
        <Style TargetType="Border">
            <!-- Resting: transparent background -->
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <!-- Hover: subtle surface background -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brushes.Subtle.Surface}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Border.Style>

</Border>
