<Border x:Class="BioCentri.App.Components.Inputs.ToggleSwitch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:BioCentri.App.Components.Nav"
        Background="Transparent"
        Cursor="Hand"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        ToolTip="{Binding Description, RelativeSource={RelativeSource Self}}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0">
            <TextBlock x:Name="LabelText"
                       Text="Setting"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Body}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Text.Primary}" />
            <TextBlock x:Name="DescriptionText"
                       Text=""
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ToggleButton Grid.Column="1"
                      x:Name="Switch"
                      IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=Border}, Mode=TwoWay}"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Cursor="Hand"
                      Focusable="True"
                      AutomationProperties.Name="{Binding Label, RelativeSource={RelativeSource AncestorType=Border}}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="42" Height="24">
                        <Border x:Name="Track"
                                CornerRadius="12"
                                Background="{StaticResource Brushes.Ink.600}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brushes.Ink.600}" />
                                </Style>
                            </Border.Style>
                        </Border>
                        <Ellipse x:Name="Thumb"
                                 Width="18"
                                 Height="18"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="3,0,0,0"
                                 Fill="White">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="ThumbTranslate" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brushes.Accent.Indigo}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.86" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
    </Grid>
</Border>
