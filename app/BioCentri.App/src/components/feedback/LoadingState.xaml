<StackPanel x:Class="BioCentri.App.Components.Feedback.LoadingState"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">

    <Ellipse x:Name="Dot"
             Width="6" Height="6"
             Margin="{StaticResource Spacing.Pad.Xs}"
             VerticalAlignment="Center"
             Fill="{StaticResource Brushes.Accent.Indigo}">
        <Ellipse.Triggers>
            <EventTrigger RoutedEvent="Ellipse.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="False">
                        <DoubleAnimationUsingKeyFrames
                            Storyboard.TargetProperty="Opacity"
                            Duration="0:0:1.4">
                            <SplineDoubleKeyFrame KeyTime="0:0:0"    Value="0.35" />
                            <SplineDoubleKeyFrame KeyTime="0:0:0.7"  Value="1.0" />
                            <SplineDoubleKeyFrame KeyTime="0:0:1.4"  Value="0.35"
                                                  KeySpline="0.16,1,0.3,1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Ellipse.Triggers>
    </Ellipse>

    <TextBlock Text="Loading..."
               FontFamily="{StaticResource Typography.Sans}"
               FontSize="{StaticResource Typography.Size.Small}"
               Foreground="{StaticResource Brushes.Text.Muted}"
               VerticalAlignment="Center"
               Margin="{StaticResource Spacing.Pad.Xs}" />

</StackPanel>
