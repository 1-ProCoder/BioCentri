<Border x:Class="BioCentri.App.Components.Feedback.EmptyState"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
        Background="Transparent"
        Padding="{StaticResource Spacing.Pad.Xxl}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">

        <icon:Icon x:Name="LeadingIcon"
                   IconSize="48"
                   HorizontalAlignment="Center"
                   GeometryKey="Icons.Status.Info"
                   Stroke="{StaticResource Brushes.Accent.IndigoLight}"
                   Opacity="0.7"
                   Margin="0,0,0,16" />

        <TextBlock x:Name="TitleText"
                   Text="Nothing here yet"
                   FontFamily="{StaticResource Typography.Display}"
                   FontSize="{StaticResource Typography.Size.H3}"
                   FontWeight="{StaticResource Typography.Weight.SemiBold}"
                   Foreground="{StaticResource Brushes.Text.Primary}"
                   TextAlignment="Center" />

        <TextBlock x:Name="SubtitleText"
                   Text="Once a feature ships, its capability will show up here."
                   FontFamily="{StaticResource Typography.Sans}"
                   FontSize="{StaticResource Typography.Size.Body}"
                   Foreground="{StaticResource Brushes.Text.Muted}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="{StaticResource Spacing.Pad.Lg}" />

        <ContentPresenter x:Name="Actions"
                          HorizontalAlignment="Center"
                          Margin="{StaticResource Spacing.Pad.Lg}" />
    </StackPanel>

</Border>
