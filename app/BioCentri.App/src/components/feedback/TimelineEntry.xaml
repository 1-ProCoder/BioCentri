<Grid x:Class="BioCentri.App.Components.Feedback.TimelineEntry"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:icon="clr-namespace:BioCentri.App.Components.Iconography"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="36" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Vertical rail with the dot -->
    <Grid Grid.Column="0"
          Margin="0,4,0,0">
        <Rectangle Width="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Stretch"
                   Margin="0,18,0,-8"
                   Fill="{StaticResource Brushes.Border.Hairline}" />

        <Border x:Name="Dot"
                Width="14"
                Height="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="7"
                Background="{StaticResource Brushes.Accent.Indigo}"
                BorderThickness="2"
                BorderBrush="{StaticResource Brushes.Surface.Base}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brushes.Accent.Indigo}" />
                </Style>
            </Border.Style>
        </Border>

        <icon:Icon x:Name="DotIcon"
                   IconSize="10"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,2,0,0"
                   GeometryKey="Icons.Status.Check"
                   Stroke="White" />
    </Grid>

    <!-- Entry card -->
    <Border Grid.Column="1"
            Background="{StaticResource Brushes.Surface.Card}"
            BorderBrush="{StaticResource Brushes.Border.Hairline}"
            BorderThickness="1"
            CornerRadius="{StaticResource Corners.Md}"
            Padding="{StaticResource Spacing.Pad.Lg}"
            Margin="0,0,0,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText"
                           Text="Title"
                           FontFamily="{StaticResource Typography.Sans}"
                           FontSize="{StaticResource Typography.Size.Body}"
                           FontWeight="{StaticResource Typography.Weight.SemiBold}"
                           Foreground="{StaticResource Brushes.Text.Primary}"
                           VerticalAlignment="Center" />
                <Border x:Name="SeverityBadge"
                        CornerRadius="{StaticResource Corners.Pill}"
                        Padding="10,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource Brushes.Subtle.Surface}">
                    <TextBlock x:Name="SeverityText"
                               Text="Info"
                               FontFamily="{StaticResource Typography.Sans}"
                               FontSize="{StaticResource Typography.Size.Caption}"
                               FontWeight="{StaticResource Typography.Weight.SemiBold}"
                               Foreground="{StaticResource Brushes.Accent.IndigoLight}" />
                </Border>
                <TextBlock x:Name="TimestampText"
                           Text=""
                           FontFamily="{StaticResource Typography.Sans}"
                           FontSize="{StaticResource Typography.Size.Caption}"
                           Foreground="{StaticResource Brushes.Text.Muted}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="DetailText"
                       Text=""
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />

            <ContentPresenter x:Name="Actions"
                              HorizontalAlignment="Left"
                              Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Grid>
