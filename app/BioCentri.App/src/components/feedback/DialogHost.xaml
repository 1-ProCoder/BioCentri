<Grid x:Class="BioCentri.App.Components.Feedback.DialogHost"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      IsHitTestVisible="True"
      Background="Transparent"
      Visibility="Collapsed">

    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Rectangle x:Name="Dimmer"
               Fill="{StaticResource Brushes.Scrim}"
               IsHitTestVisible="True"
               Opacity="0" />

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="640"
          MinWidth="320"
          Margin="{StaticResource Spacing.Pad.Xl}">

        <!--
            IMPORTANT: DialogPresenter MUST declare its RenderTransform
            (and origin) up-front. Transitions.Dialog.PopIn animates
            (UIElement.RenderTransform).(ScaleTransform.ScaleX/Y); if the
            presenter has no RenderTransform at all, WPF raises a path-
            resolution error on every composition pass instead of simply
            being a no-op. The PopIn storyboard doubles in (0.94 → 1.0)
            and we want the scale anchored to the centre so the dialog
            grows in place rather than drifting from the top-left.
        -->
        <ContentPresenter x:Name="DialogPresenter"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsHitTestVisible="True"
                          RenderTransformOrigin="0.5,0.5">
            <ContentPresenter.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </ContentPresenter.RenderTransform>
        </ContentPresenter>
    </Grid>

</Grid>
