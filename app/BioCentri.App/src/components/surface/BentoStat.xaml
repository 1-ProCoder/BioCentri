<UserControl x:Class="BioCentri.App.Components.Surface.BentoStat"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:motion="clr-namespace:BioCentri.App.Components.Motion"
             x:Name="Root">
    <motion:BorderTrace>
        <StackPanel Margin="{StaticResource Spacing.Pad.Lg}">
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Caption}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Accent.IndigoLight}" />

            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="{StaticResource Typography.Display}"
                       FontSize="{StaticResource Typography.Size.Display}"
                       FontWeight="{StaticResource Typography.Weight.SemiBold}"
                       Foreground="{StaticResource Brushes.Text.Primary}"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{Binding Caption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="{StaticResource Typography.Sans}"
                       FontSize="{StaticResource Typography.Size.Small}"
                       Foreground="{StaticResource Brushes.Text.Muted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </motion:BorderTrace>
</UserControl>
