<Border x:Class="BioCentri.App.Components.Surface.FocalCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource Brushes.Focal.Background}"
        BorderBrush="{StaticResource Brushes.Border.Hairline}"
        BorderThickness="1"
        CornerRadius="{StaticResource Corners.Lg}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Effect="{StaticResource Shadows.Card.Default}">

    <Border BorderBrush="{StaticResource Shadows.InnerHighlight.Default}"
            BorderThickness="0,1,0,0"
            CornerRadius="{StaticResource Corners.Lg}">
        <ContentPresenter x:Name="Body"
                          Margin="{StaticResource Spacing.Pad.Xl}" />
    </Border>

</Border>
