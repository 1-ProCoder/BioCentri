<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>BioCentri.App</RootNamespace>
    <!-- Emitted assembly name follows the project name so XAML
         clr-namespace aliases (`assembly=BioCentri.App`) resolve
         without per-file edits. The shipped binary is `BioCentri.App.exe`. -->
    <AssemblyName>BioCentri.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <!-- The WPF SDK's recursive '**\*.xaml' Page glob is suppressed.
         Explicit Page entries below are the only source. This avoids
         NETSDK1022 duplicate-items and lets us keep a definitive list
         of XAML files that compile into the assembly (subset decisions
         documented in docs/DECISIONS.md). -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <Version>0.5.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.5.0+milestone.5</InformationalVersion>
  </PropertyGroup>

  <!--
    M1 packages are deliberately dep-light because the offline NuGet cache
    on the build machine does not carry Wpf.Ui 3.0.5 or
    Microsoft.Extensions.DependencyInjection 8.x. The plan's locked package
    list (Wpf.Ui + M.E.DI + CommunityToolkit.Mvvm) is restored at Milestone 2+
    — see docs/DECISIONS.md Decision 9.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.1.0" />
    <!-- Milestone 6: tray icon. The modern community fork of
         Hardcodet.NotifyIcon.Wpf (H.NotifyIcon.Wpf) targets net8.0-windows. -->
    <!-- Milestone 6: WMI process monitoring (System.Management for
         ManagementEventWatcher / Win32_ProcessStartTrace). -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Milestone 5: reference BioCentri.Core so App can inject
       IHelloService (the pure WinRT adapter) into BiometricAuthService. -->
  <ItemGroup>
    <ProjectReference Include="..\BioCentri.Core\BioCentri.Core.csproj" />
  </ItemGroup>

