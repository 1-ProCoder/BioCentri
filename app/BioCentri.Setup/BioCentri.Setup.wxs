<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!--
    BioCentri — WiX 3.14 installer source.
    Build:
      1. dotnet publish app/BioCentri.App -c Release -o app/publish
      2. heat.exe dir ..\publish -dr INSTALLFOLDER -cg AppComponents -gg -sfrag -out obj\harvest.wxs
      3. candle.exe BioCentri.Setup.wxs obj\harvest.wxs -o obj\
      4. light.exe obj\BioCentri.Setup.wixobj obj\harvest.wixobj -o bin\BioCentri.msi

    The ComponentGroup below is a placeholder. Replace with the one
    generated by heat.exe in step 2 before running candle.exe.
  -->

  <Product
    Id="*"
    Name="BioCentri"
    Language="1033"
    Version="1.0.0"
    Manufacturer="BioCentri"
    UpgradeCode="{B1C3E500-10C3-4E50-B10C-3A21D0000001}">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Comments="BioCentri — Protect your Windows apps with biometric security."
      Description="A privacy-focused, local-first Windows 11 application that protects individual apps with Windows Hello biometrics." />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of BioCentri is already installed. Remove it before installing this version." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Suppress .NET Framework prerequisite on modern Windows -->
    <PropertyRef Id="WIX_IS_NETFRAMEWORK_4_6_1_OR_LATER_INSTALLED" />
    <Property Id="WIX_IS_NETFRAMEWORK_4_6_1_OR_LATER_INSTALLED" Value="1" />

    <!-- ── Installation directories ── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="BioCentri" />
      </Directory>

      <!-- Start Menu shortcut -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="StartMenuBioCentri" Name="BioCentri" />
      </Directory>
    </Directory>

    <!-- ── Feature ── -->
    <Feature
      Id="Main"
      Title="BioCentri"
      Level="1"
      ConfigurableDirectory="INSTALLFOLDER"
      Description="Core BioCentri application files.">
      <!-- ComponentGroup is auto-generated by heat.exe. See build steps above. -->
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- ── Start Menu shortcut ── -->
    <DirectoryRef Id="StartMenuBioCentri">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
          Id="BioCentriShortcut"
          Name="BioCentri"
          Description="Protect your Windows apps with biometric security"
          Target="[INSTALLFOLDER]BioCentri.App.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveStartMenuBioCentri" Directory="StartMenuBioCentri" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\BioCentri"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- ── Add/Remove Programs properties ── -->
    <Property Id="ARPCONTACT" Value="support@biocentri.app" />
    <Property Id="ARPHELPLINK" Value="https://biocentri.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://biocentri.com" />

  </Product>
</Wix>
